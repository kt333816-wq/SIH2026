# Server
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-serviso-domain.pages.dev

# PostgreSQL (use Supabase, Neon, Railway, or Cloudflare Hyperdrive+Postgres - all have free tiers)
DATABASE_URL=postgresql://user:password@host:5432/serviso

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Email (OTP delivery) - use a real transactional provider, not your personal Gmail
# Recommended: Resend, SendGrid, Postmark, or Brevo (all have free tiers good enough for a hackathon demo)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace_with_smtp_api_key
EMAIL_FROM="Serviso <no-reply@serviso.org>"

# Cloudflare Turnstile (captcha) - get keys free at dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key

# Admin bootstrap account (created on first migrate run, used to review pending signups)
ADMIN_EMAIL=admin@serviso.com
ADMIN_PASSWORD=DyKaMESSIAH+09

# OTP settings
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6